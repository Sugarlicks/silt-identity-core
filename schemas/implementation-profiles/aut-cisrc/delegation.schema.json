{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siltcore.org/schemas/implementation-profiles/aut-cisrc/delegation.schema.json",
  "title": "AUT CISRC Delegation Artefact",
  "description": "Profile-specific schema for a delegation artefact in the AUT CISRC implementation profile. This schema is non-normative and does not modify SILT Core v0.1.",
  "type": "object",
  "required": [
    "delegationId",
    "issuer",
    "delegate",
    "authorityChain",
    "scope",
    "resource",
    "permittedActions",
    "purpose",
    "effectiveFrom",
    "expiresAt",
    "status",
    "issuedAt"
  ],
  "properties": {
    "delegationId": {
      "type": "string",
      "description": "Unique identifier for the delegation artefact."
    },
    "issuer": {
      "$ref": "#/$defs/actor"
    },
    "delegate": {
      "$ref": "#/$defs/actor"
    },
    "authorityChain": {
      "type": "object",
      "required": [
        "authorityChainId"
      ],
      "properties": {
        "authorityChainId": {
          "type": "string"
        },
        "authorityChainRef": {
          "type": "string",
          "description": "Optional reference to a separately stored authority-chain artefact."
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "scopeId",
        "scopeType"
      ],
      "properties": {
        "scopeId": {
          "type": "string"
        },
        "scopeType": {
          "type": "string",
          "description": "Type of delegated scope, such as dataset, repository, project, ethics, or governance."
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": [
        "resourceId",
        "resourceType"
      ],
      "properties": {
        "resourceId": {
          "type": "string"
        },
        "resourceType": {
          "type": "string",
          "description": "Type of resource, such as dataset, repositoryItem, projectRecord, ethicsRecord, or governanceRecord."
        },
        "resourceName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "permittedActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "description": "Permitted action, such as dataset.read, dataset.submit, repository.submit, repository.update, or ethics.view."
      }
    },
    "purpose": {
      "type": "string",
      "description": "The permitted purpose for which the delegation may be used."
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time from which the delegation becomes valid."
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time after which the delegation is no longer valid."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "revoked",
        "superseded"
      ]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "proof": {
      "type": "object",
      "description": "Optional proof metadata for the delegation artefact.",
      "properties": {
        "proofType": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "verificationMethod": {
          "type": "string"
        },
        "proofValue": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidenceDocuments": {
      "type": "array",
      "description": "Documents supporting the authority basis for this delegation.",
      "items": {
        "$ref": "#/$defs/evidenceDocument"
      }
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "required": [
        "actorId",
        "role"
      ],
      "properties": {
        "actorId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "authorityNodeId": {
          "type": "string",
          "description": "Optional reference to the actor's authority node in the authority chain."
        }
      },
      "additionalProperties": false
    },
    "evidenceDocument": {
      "type": "object",
      "required": [
        "documentRef",
        "documentType"
      ],
      "properties": {
        "documentRef": {
          "type": "string"
        },
        "documentType": {
          "type": "string"
        },
        "documentTitle": {
          "type": "string"
        },
        "documentHash": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
